# Copy to renderer/.env (gitignored) to switch on the AI writing assistant —
# the "Shorten to fit" button on the CCR's edit form. ./demo.sh start loads it.
#
# Optional. Without it the button is never offered and everything else, the
# five-beat rehearsal included, runs exactly as it does with it.
ANTHROPIC_API_KEY=

# The model that writes. The request in lib/llm.js is shaped for this one.
# CCR_AI_MODEL=claude-opus-5
