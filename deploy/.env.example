# Copy to deploy/.env on the VM (never commit it). docker compose reads it.

# Public names; both must resolve to the VM before `up`, for TLS.
CCR_HOST=ccr-poc.example.com
MCP_HOST=mcp-poc.example.com

DB_NAME=ccr
DB_USER=ccr
DB_PASSWORD=          # openssl rand -hex 24
DRUPAL_HASH_SALT=     # openssl rand -hex 32

# One name:key pair per tester, comma-separated. Keys >= 24 chars.
#   for n in alice bob; do echo "$n:$(openssl rand -hex 24)"; done
MCP_KEYS=

# Optional. Only the renderer's writing assistant uses it (phase 2).
ANTHROPIC_API_KEY=
